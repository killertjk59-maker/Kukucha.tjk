# ====== Telegram Bot ======
# Токени ботро аз @BotFather гиред
BOT_TOKEN=123456:ABC-DEF_your_bot_token_here

# Username-и бот (бе @). Барои тугмаи "Войти через Telegram" лозим
BOT_USERNAME=KukuchaShopBot

# ID-и админ/менеҷерҳо (рақамҳо бо вергул ҷудо карда мешаванд)
# Як админ:
ADMIN_TELEGRAM_ID=123456789
# Якчанд админ:
ADMIN_TELEGRAM_IDS=123456789,987654321

# ====== PostgreSQL ======
# Railway инро худкор мегузорад (DATABASE_URL). Дар локалӣ тағйир диҳед.
DATABASE_URL=postgresql://postgres:password@localhost:5432/kukucha

# ====== Сессияҳо ======
# Рамзи махфӣ (ҳар гуна сатри дароз ва тасодуфӣ)
SESSION_SECRET=change_me_to_a_long_random_string

# ====== Мағоза ======
# Рақами пардохт (ҳамёни мобилӣ)
PAYMENT_PHONE=988757967
# Номи соҳиби ҳамён
PAYMENT_OWNER=Душанбе Сити
# Порти сервер (Railway худкор PORT-ро мегузорад)
PORT=3000
# URL-и сайт (барои истинодҳо). Дар Railway https://your-app.up.railway.app
PUBLIC_URL=http://localhost:3000
